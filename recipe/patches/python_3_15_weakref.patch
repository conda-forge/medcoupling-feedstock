@@ -25,6 +25,27 @@
 
 #include <Python.h>
 
+// PyWeakref_GetObject was removed in Python 3.15. The referent of a weak reference as a borrowed
+// reference, Py_None when it is gone: what PyWeakref_GetObject gave, through PyWeakref_GetRef
+// (Python 3.13 and later) where there is one.
+static inline PyObject *
+MEDCouplingWeakrefGetObject(PyObject *weakRef)
+{
+#if PY_VERSION_HEX >= 0x030D0000
+    PyObject *obj = NULL;
+    if (PyWeakref_GetRef(weakRef, &obj) <= 0)
+    {
+        PyErr_Clear();
+        return Py_None;
+    }
+    // The callers take a borrowed reference, as before: whoever kept the object alive still does.
+    Py_DECREF(obj);
+    return obj;
+#else
+    return PyWeakref_GetObject(weakRef);
+#endif
+}
